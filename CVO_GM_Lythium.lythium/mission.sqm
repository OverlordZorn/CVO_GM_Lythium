					property="mum_intel_intel_handwritten";
					expression="_this setVariable ['mum_intel_intel_handwritten',_value,true];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="15 OCT. Farid did not eat again. He sits with the phone and says nothing. Rahim says leave him alone, everyone has debts.<br/><br/>17 OCT. We sat here after shift. Water pipe, tea. Nobody asks questions here. Farid did not come.<br/><br/>19 OCT. Rahim traded two cartons for a bag again. Jabbar's cousin. I told him it will end badly. He laughed.<br/><br/>21 OCT. Farid asked me what happens to a man who sells his own. He said it was a joke. It was not a joke. He never takes off that white scarf, even in the heat.<br/><br/>22 OCT. The patrol did not come back. Farid is pale and says nothing.";
						};
					};
				};
				class Attribute2
				{
					property="mum_intel_intel_desc";
					expression="_this setVariable ['mum_intel_intel_desc',_value,true];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="A small journal lying beside the water pipe. The last entries are about Farid.";
						};
					};
				};
				class Attribute3
				{
					property="mum_intel_actionDuration";
					expression="_this setVariable ['mum_intel_actionDuration',_value,true];";

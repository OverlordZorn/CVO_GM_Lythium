					property="mum_intel_intel_desc";
					expression="_this setVariable ['mum_intel_intel_desc',_value,true];";
					class Value
					{
						class data
						{
							singleType="STRING";
							value="My dear brother,<br/><br/>The doctor in the city says the treatment cannot wait past the winter. I did not want to tell you, but Mother says you must know. Please do not do anything foolish for money. We will manage somehow, with God's help.<br/><br/>Wear the white shemag I gave you. The nights in the hills are cold, and I want you to think of home when you wear it.<br/><br/>Come back to us safe.<br/>Your sister, Laila";
						};
					};
				};
				class Attribute3
				{
